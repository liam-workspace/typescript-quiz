{
  "name": "razzia",
  "version": "3.1.0",
  "type": "module",
  "scripts": {
    "dev": "dotenv -e .env -- pnpm -r --parallel dev",
    "dev:web": "dotenv -e .env -- pnpm --filter web dev",
    "dev:socket": "dotenv -e .env -- pnpm --filter socket dev",
    "build": "pnpm --filter @pp/common build && pnpm --filter @pp/db build && pnpm --filter @pp/server build",
    "start": "pnpm -r --parallel run start",
    "clean": "pnpm -r exec rm -rf dist node_modules",
    "typecheck": "pnpm build && pnpm -r exec tsc --noEmit && tsc -p scripts/tsconfig.json",
    "test": "pnpm build && pnpm --filter @pp/common test && pnpm --filter @pp/db test && pnpm --filter @pp/server test",
    "test:db": "pnpm --filter @pp/db test",
    "lint": "pnpm build && oxlint",
    "lint:fix": "pnpm build && oxlint --fix",
    "lint:frontend": "frontend-lint packages/app/src || true",
    "lint:i18n": "i18n-lint packages/app/src || true",
    "format": "prettier --check . --log-level warn",
    "format:fix": "prettier --write . --log-level warn",
    "seed": "pnpm build && dotenv -e .env -- node scripts/seed-test.ts"
  },
  "dependencies": {
    "@liam-public/node-postgres": "^0.3.1",
    "@pp/common": "workspace:*",
    "@pp/db": "workspace:*",
    "pg": "^8.13.0"
  },
  "devDependencies": {
    "@liam-public/node-frontend-lint": "^0.4.0",
    "@liam-public/node-i18n-lint": "^0.2.0",
    "@stylistic/eslint-plugin": "latest",
    "@types/node": "^26.0.1",
    "@types/pg": "^8.11.0",
    "dotenv-cli": "^11.0.0",
    "oxlint": "latest",
    "oxlint-tsgolint": "^0.23.0",
    "prettier": "^3.8.5",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.0"
  }
}
