# Copy to .env.local and fill in. .env.local is gitignored; this file is not,
# so it must never contain a real token.
#
# The dev issuer is a live OIDC provider (auth-dev.icovn.me) that federates
# Google and Microsoft. It presents its own account chooser, so this app
# sends ONE authorize request and does not name a provider.
VITE_AUTH_ISSUER=https://auth-dev.icovn.me
VITE_AUTH_CLIENT_ID=local-dev
# Must match a redirect URI registered with the issuer EXACTLY, including
# port and path. The dev server therefore runs on 3000, not Vite's 5173.
VITE_AUTH_REDIRECT_URI=http://localhost:3000/callback

# Dev-only shortcut: skip the interactive round trip and use a pre-issued
# token. Never set these in a deployed build.
VITE_DEV_AUTH=false
VITE_DEV_AUTH_TOKEN=
VITE_DEV_EMAIL=
